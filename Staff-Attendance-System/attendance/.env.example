# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# docker-compose reads .env automatically - never commit the real .env file.

# MySQL root password (also used by the app to connect)
DB_PASSWORD=change_this_to_a_strong_password

# 32+ random characters. Generate with:  openssl rand -base64 48
JWT_SECRET=replace_with_a_random_32plus_character_value

# Bootstrap Admin password (username: Admin). Change it - required when SPRING_PROFILES_ACTIVE=prod.
ADMIN_PASSWORD=Admin@123

# true = create the demo staff (owner01, sales01 ...). Use false for real deployments.
SEED_DEMO_USERS=true
