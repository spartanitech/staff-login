# Copy this file to "application-local.properties" (same folder), fill in the
# real values, and run with the "local" profile (the IntelliJ run configuration
# in .run/ already does that; otherwise use --spring.profiles.active=local or
# SPRING_PROFILES_ACTIVE=local).
#
# This is a SPRING PROPERTIES file: use real Spring property keys
# (spring.datasource.password), NOT environment-variable names (DB_PASSWORD).
# application-local.properties is git-ignored, so your password is never committed.

spring.datasource.url=jdbc:mysql://localhost:3306/staff_attendance_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata
spring.datasource.username=root
spring.datasource.password=your_real_mysql_password_here

# Optional locally (random per run if left out). 32+ random characters if you set it.
# app.jwt.secret=replace_with_a_random_value_of_32_or_more_characters

# Optional: change the bootstrap Admin password (default Admin@123)
# app.admin.password=Admin@123
